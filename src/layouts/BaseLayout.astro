---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  schema?: object;
}

const {
  title,
  description = 'Alexandros Emmanouilidis - Computer Science student, fencer, and writer based in Cyprus.',
  ogImage = '/images/og-image.jpg',
  canonicalURL = Astro.url.href,
  schema,
} = Astro.props;

const fullTitle = title === 'Home'
  ? 'Alex Emmanouilidis'
  : `${title} - Alex Emmanouilidis`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Fonts - self-hosted, declared in global.css. Nothing is fetched
         from a third-party origin. Only the two faces that render above
         the fold on every page are preloaded: the serif for the heading,
         the sans at 400 for body copy. The rest load on demand. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-serif-display-400-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-sans-400-latin.woff2" crossorigin />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="Alex Emmanouilidis" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={new URL(ogImage, Astro.site)} />

    <!-- Twitter / X card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={new URL(ogImage, Astro.site)} />

    <!-- Favicon placeholder - replace with real icon in Phase 6 -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Structured data (JSON-LD) - passed per-page via schema prop -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
